# ============================================
# MamaCare — Environment Variables
# Copy to .env.local for local dev. Paste each into Vercel → Settings → Environment Variables.
# ============================================

# ---------- Site ----------
# Must be your LIVE domain. If this points at an old/deleted Vercel deployment,
# customers land on a 404 after paying, and canonical/sitemap URLs break SEO.
NEXT_PUBLIC_SITE_URL=https://mamacare.us

# ── Sales tax ────────────────────────────────────────────────────────────────
# Set to "true" ONLY AFTER you have:
#   1. Enabled Stripe Tax:  Stripe Dashboard → Tax → Get started
#   2. Set your origin address (where you ship from)
#   3. Added a tax registration for every state/country you must collect in
#      (Stripe Dashboard → Tax → Registrations)
#
# Stripe only charges tax in jurisdictions you have registered. Enabling this
# without registrations means $0 tax collected. Enabling it with Stripe Tax
# switched off makes Stripe reject checkout sessions entirely — which is why
# it defaults to off.
STRIPE_AUTOMATIC_TAX=false

# Required for the inline (embedded) card form on the checkout page. This is
# the PUBLISHABLE key (pk_live_… / pk_test_…), safe to expose to the browser —
# never put the secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AI image descriptions ────────────────────────────────────────────────────
# Powers Admin → Image alt text. Uses gpt-4o-mini vision at roughly $0.0002 per
# image, so a 200-image catalogue costs a few cents as a one-off. Without it the
# admin page still works for writing alt text by hand.
OPENAI_API_KEY=

# ── CJ Dropshipping sync ─────────────────────────────────────────────────────
# Required for the scheduled sync at /api/cron/cj-sync. Vercel sends this
# automatically as a Bearer token on cron invocations. Without it the job
# refuses to run rather than exposing an unauthenticated endpoint that writes
# to your product catalogue. Generate any long random string.
CRON_SECRET=

# Already needed for CJ order fulfilment and product import:
CJ_API_EMAIL=
CJ_API_KEY=

# ---------- Admin accounts (two named admins) ----------
# Each admin has user/password + a display NAME used for activity logging.
ADMIN_USER_1=david
ADMIN_PASSWORD_1=change-me-strong
ADMIN_NAME_1=David

ADMIN_USER_2=coadmin
ADMIN_PASSWORD_2=change-me-strong-too
ADMIN_NAME_2=Co-admin

# Used only to gate the one-time DB init endpoint:
ADMIN_SECRET=long-random-string-for-init-endpoint

# (Legacy single-admin fallback — only used if ADMIN_USER_1 is not set)
# ADMIN_USER=
# ADMIN_PASSWORD=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=rk_live_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------- PayPal ----------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_ENV=live

# ---------- CJ Dropshipping ----------
CJ_API_EMAIL=you@example.com
CJ_API_KEY=replace_me
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1

# ---------- Resend (transactional + receipt emails) ----------
RESEND_API_KEY=re_replace_me
RESEND_FROM=MamaCare <orders@yourdomain.com>
CONTACT_EMAIL=mamaacaree@gmail.com

# ---------- Vercel Postgres ----------
# Auto-injected when you connect a Postgres database to the project.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=
